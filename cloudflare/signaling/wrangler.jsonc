{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "goose-game-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://derekalvarado.github.io"
  },
  "ratelimits": [
    {
      "name": "ROOM_HANDSHAKES",
      "namespace_id": "20261001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "SignalingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true
  }
}
